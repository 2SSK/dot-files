#!/usr/bin/env python3
"""desktop-key-release alt|ctrl: wait until neither key of that modifier is held (X11), then exit 0;
1 without a display, 2 on an unknown key, 3 after a minute.

The window switcher's end (Alt+Tab): i3 can't see Alt let go when it was pressed before the
switcher's mode began (the press wasn't grabbed), so the shell runs this while switching. It asks
X for the keyboard's state every 20 ms; nothing is grabbed, apps keep every key.
"""
import ctypes
import ctypes.util
import sys
import time

KEYSYMS = {"ctrl": (0xFFE3, 0xFFE4), "alt": (0xFFE9, 0xFFEA)}  # left and right


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in KEYSYMS:
        print("usage: desktop-key-release alt|ctrl", file=sys.stderr)
        return 2
    x11 = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    x11.XQueryKeymap.argtypes = [ctypes.c_void_p, ctypes.c_char * 32]
    display = x11.XOpenDisplay(None)
    if not display:
        print("desktop-key-release: no X display", file=sys.stderr)
        return 1
    codes = [c for c in (x11.XKeysymToKeycode(display, k) for k in KEYSYMS[sys.argv[1]]) if c]
    keys = ctypes.create_string_buffer(32)
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        x11.XQueryKeymap(display, keys)
        state = keys.raw
        if not any(state[c // 8] & (1 << (c % 8)) for c in codes):
            return 0
        time.sleep(0.02)
    return 3


if __name__ == "__main__":
    sys.exit(main())
