#!/usr/bin/env bash
# SwayFX's effects (~/.config/sway/effects.conf) sent to the running compositor as commands, when
# it is SwayFX: sway runs this at startup and on each reload. Plain sway has no such commands.
#   desktop-effects
set -euo pipefail

[[ -n ${SWAYSOCK:-} ]] || exit 0
# SwayFX names itself only in `sway --version` (its IPC version reply is just the number)
[[ $(sway --version 2>/dev/null) == swayfx* ]] || exit 0
conf="${XDG_CONFIG_HOME:-$HOME/.config}/sway/effects.conf"
commands="$(grep -vE '^\s*(#|$)' "$conf" | paste -sd';')"
swaymsg -r -- "$commands" | grep -q '"success": false' && echo "desktop-effects: sway refused some of effects.conf" >&2
exit 0
