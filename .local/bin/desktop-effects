#!/usr/bin/env bash
# SwayFX's effects (~/.config/sway/effects.conf) in sway's config, on SwayFX only: sway includes
# ~/.local/state/desktop/sway-effects*.conf, and this links it there (or removes it on plain sway,
# which has no such commands). Sway runs it at startup and on each reload; the first time it reloads
# sway once to read it. (Sent as commands instead, `blur enable` sets only the focused window.)
#   desktop-effects
set -euo pipefail

[[ -n ${SWAYSOCK:-} ]] || exit 0
link="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/sway-effects.conf"
# SwayFX names itself only in `sway --version` (its IPC version reply is just the number)
if [[ $(sway --version 2>/dev/null) != swayfx* ]]; then
	rm -f "$link"
	exit 0
fi
[[ -e $link ]] && exit 0
mkdir -p "${link%/*}"
ln -sfn "${XDG_CONFIG_HOME:-$HOME/.config}/sway/effects.conf" "$link"
swaymsg -q reload
