#!/usr/bin/env bash
# Links ~/.config/sway/effects.conf where sway's config includes it, on SwayFX only (plain sway
# would refuse it); the first time, sway reloads to read it. Run at startup and on each reload.
#   desktop-effects
set -euo pipefail

[[ -n ${SWAYSOCK:-} ]] || exit 0
link="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/sway-effects.conf"
# SwayFX names itself only in `sway --version` (its IPC version reply is just the number)
if [[ $(sway --version 2>/dev/null) != swayfx* ]]; then
	rm -f "$link"
	exit 0
fi
[[ -e $link ]] && exit 0
mkdir -p "${link%/*}"
ln -sfn "${XDG_CONFIG_HOME:-$HOME/.config}/sway/effects.conf" "$link"
swaymsg -q reload
