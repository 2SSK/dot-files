#!/usr/bin/env bash
# Select the central desktop theme (~/.local/state/desktop/theme) and reload what uses it.
set -euo pipefail

lib="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/desktop" && pwd)"
# shellcheck source-path=SCRIPTDIR/../.. source=.local/lib/desktop/log.sh
source "$lib/log.sh"

themes="$lib/../../share/desktop/themes"
state="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/theme"

usage() {
	cat <<'EOF'
usage: theme set <family> [--mode dark|light]
       theme mode dark|light|toggle
       theme list
       theme current
EOF
}

current() { # prints "<family> <mode>"; tokyonight dark until a theme is set
	local family=tokyonight mode=dark
	# shellcheck disable=SC1091 # family=/mode= written by theme_render.py
	[[ -r $state/current ]] && source "$state/current"
	echo "$family $mode"
}

link_config() { # <path under ~/.config> <rendered file>: apps that only read a fixed path get a link
	local dest="${XDG_CONFIG_HOME:-$HOME/.config}/$1" src="$state/$2"
	[[ -L $dest && $(readlink "$dest") == "$src" ]] && return 0
	if [[ -e $dest || -L $dest ]]; then # someone else's file: keep it, out of the way
		local backup="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/backup/theme"
		mkdir -p "$backup/${1%/*}"
		mv "$dest" "$backup/$1.$(date +%Y%m%d-%H%M%S)"
		log_warn moved_aside path="$dest" to="$backup"
	fi
	mkdir -p "${dest%/*}"
	ln -s "$src" "$dest"
}

gtk_settings() { # <mode>: what GTK on Wayland and libadwaita read (X11 GTK reads xsettingsd)
	command -v gsettings >/dev/null || return 0
	local schema=org.gnome.desktop.interface
	gsettings list-schemas 2>/dev/null | grep -qx "$schema" || return 0
	local dark=0
	[[ $1 == dark ]] && dark=1
	gsettings set "$schema" color-scheme "$( ((dark)) && echo prefer-dark || echo prefer-light)"
	gsettings set "$schema" gtk-theme "$( ((dark)) && echo adw-gtk3-dark || echo adw-gtk3)"
	gsettings set "$schema" icon-theme "Tela-circle-blue-$1"
	gsettings set "$schema" cursor-theme Bibata-Modern-Ice
	gsettings set "$schema" cursor-size 24
	gsettings set "$schema" font-name 'Inter 11'
	gsettings set "$schema" monospace-font-name 'JetBrainsMono Nerd Font 11'
}

apply() { # <family> <mode>
	python3 "$lib/theme_render.py" render "$1" "$2"
	link_config gtk-3.0/gtk.css gtk-3.0.css
	link_config gtk-4.0/gtk.css gtk-4.0.css
	link_config qt5ct/qt5ct.conf qt5ct.conf
	link_config qt6ct/qt6ct.conf qt6ct.conf
	gtk_settings "$2" || log_warn gsettings_failed msg='no session bus? GTK on Wayland keeps its old settings'
	# Reload running consumers; foot can only switch dark/light live
	pkill -USR1 -x kitty || true
	if [[ $2 == dark ]]; then pkill -USR1 -x foot || true; else pkill -USR2 -x foot || true; fi
	pkill -USR2 -x cava || true # reload colours only
	pkill -USR1 -x nvim || true # config/theme.lua re-applies the colourscheme
	# the whole config: it sources the theme, then re-runs the plugins (continuum hooks status-right)
	if tmux info >/dev/null 2>&1; then tmux source-file "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf" || true; fi
	# i3 re-reads its config, which includes the theme's colours (sway sets I3SOCK too: skip it)
	if [[ -z ${SWAYSOCK:-} ]] && i3-msg -t get_version >/dev/null 2>&1; then i3-msg -q reload || true; fi
	pkill -USR1 -x picom || true    # re-reads its rendered config (shadow colours)
	pkill -HUP -x xsettingsd || true # icons follow dark/light
	# st reads colours from the X resource database (its reload patch re-reads it on SIGUSR1)
	if [[ -n ${DISPLAY:-} && -r $HOME/.Xresources ]] && command -v xrdb >/dev/null; then
		xrdb -merge "$HOME/.Xresources" && pkill -USR1 -x st || true
	fi
	log_info theme family="$1" mode="$2"
}

main() {
	local family mode
	read -r family mode < <(current)
	case ${1:-} in
	set)
		[[ -n ${2:-} ]] || { usage >&2 && exit 2; }
		family=$2
		if [[ ${3:-} == --mode ]]; then
			[[ ${4:-} =~ ^(dark|light)$ ]] || { usage >&2 && exit 2; }
			mode=$4
		elif [[ -n ${3:-} ]]; then
			usage >&2 && exit 2
		fi
		apply "$family" "$mode"
		;;
	mode)
		case ${2:-} in
		dark | light) mode=$2 ;;
		toggle) [[ $mode == dark ]] && mode=light || mode=dark ;;
		*) usage >&2 && exit 2 ;;
		esac
		apply "$family" "$mode"
		;;
	list)
		local f name
		for f in "$themes"/*.toml; do
			name="$(basename "$f" .toml)"
			if [[ $name == "$family" ]]; then echo "* $name"; else echo "  $name"; fi
		done
		;;
	current) echo "$family $mode" ;;
	-h | --help) usage ;;
	*) usage >&2 && exit 2 ;;
	esac
}

main "$@"
