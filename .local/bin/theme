#!/usr/bin/env bash
# Select the central desktop theme (~/.local/state/desktop/theme) and reload what uses it.
set -euo pipefail

lib="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/desktop" && pwd)"
# shellcheck disable=SC2034 # used by the consumers' reload commands
bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source-path=SCRIPTDIR/../.. source=.local/lib/desktop/log.sh
source "$lib/log.sh"

themes="$lib/../../share/desktop/themes"
state="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/theme"

usage() {
	cat <<'EOF'
usage: theme set <family> [--mode dark|light]
       theme mode dark|light|toggle
       theme list [--json]
       theme current
EOF
}

current() { # prints "<family> <mode>"; tokyonight dark until a theme is set
	local family=tokyonight mode=dark
	# shellcheck disable=SC1091 # family=/mode= written by theme_render.py
	[[ -r $state/current ]] && source "$state/current"
	echo "$family $mode"
}

# One row per app: rendered file, link under ~/.config (or -), reload command (or -). Adding an app:
# a template in share/desktop/templates and a row here. kitty gets colours over its socket and picom
# isn't reset: both would visibly redraw. tmux re-sources everything so its plugins re-apply.
consumers() {
	cat <<'EOF'
palette.json     -                  qs -c desktop ipc call theme reload
kitty.conf       -                  for s in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/kitty-*; do [[ -S $s ]] && kitten @ --to "unix:$s" set-colors --all --configured "$state/kitty.conf"; done
foot.ini         -                  pkill -$([[ $mode == dark ]] && echo USR1 || echo USR2) -x foot
cava             -                  pkill -USR2 -x cava
nvim.lua         -                  pkill -USR1 -x nvim
tmux.conf        -                  tmux info && tmux source-file "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"
i3.conf          -                  [[ -z ${SWAYSOCK:-} ]] && i3-msg -t get_version && i3-msg -q reload
picom.conf       -                  -
xsettingsd.conf  -                  pkill -HUP -x xsettingsd
st.Xresources    -                  [[ -n ${DISPLAY:-} && -r $HOME/.Xresources ]] && xrdb -merge "$HOME/.Xresources" && pkill -USR1 -x st
gtk-3.0.css      gtk-3.0/gtk.css    -
gtk-settings.ini gtk-3.0/settings.ini -
gtk-settings.ini gtk-4.0/settings.ini -
gtk-4.0.css      gtk-4.0/gtk.css    gtk_settings
qt5ct.conf       qt5ct/qt5ct.conf   -
qt6ct.conf       qt6ct/qt6ct.conf   -
sddm-theme.conf  -                  sddm
palette.json     -                  "$bin/desktop-wallpaper" screens
EOF
}

link_config() { # <path under ~/.config> <rendered file>: apps that only read a fixed path get a link
	local dest="${XDG_CONFIG_HOME:-$HOME/.config}/$1" src="$state/$2"
	[[ -L $dest && $(readlink "$dest") == "$src" ]] && return 0
	if [[ -e $dest || -L $dest ]]; then # someone else's file: keep it, out of the way
		local backup="${XDG_STATE_HOME:-$HOME/.local/state}/desktop/backup/theme"
		mkdir -p "$backup/${1%/*}"
		mv "$dest" "$backup/$1.$(date +%Y%m%d-%H%M%S)"
		log_warn moved_aside path="$dest" to="$backup"
	fi
	mkdir -p "${dest%/*}"
	ln -s "$src" "$dest"
}

gtk_settings() { # what GTK on Wayland and libadwaita read (GTK on X11 reads xsettingsd)
	local schema=org.gnome.desktop.interface dark=0
	gsettings list-schemas | grep -qx "$schema" || return 0
	[[ $mode == dark ]] && dark=1
	gsettings set "$schema" color-scheme "$( ((dark)) && echo prefer-dark || echo prefer-light)"
	gsettings set "$schema" gtk-theme "$( ((dark)) && echo adw-gtk3-dark || echo adw-gtk3)"
	gsettings set "$schema" icon-theme "Tela-circle-blue-$mode"
	gsettings set "$schema" cursor-theme Bibata-Modern-Ice
	gsettings set "$schema" cursor-size 24
	gsettings set "$schema" font-name 'Inter 11'
	gsettings set "$schema" monospace-font-name 'JetBrainsMono Nerd Font 11'
}

sddm() { # the login screen's colours, in the folder packages/system.sh sddm shares with it
	local dir="${DESKTOP_SDDM_DIR:-/var/lib/desktop/sddm}"
	[[ -w $dir ]] || return 0
	cmp -s "$state/sddm-theme.conf" "$dir/theme.conf" && return 0
	install -m 644 "$state/sddm-theme.conf" "$dir/.theme.conf.new" && mv "$dir/.theme.conf.new" "$dir/theme.conf"
}

apply() { # <family> <mode>
	local mode=$2 file link reload
	python3 "$lib/theme_render.py" render "$1" "$mode"
	while read -r file link reload; do
		[[ $link == - ]] || link_config "$link" "$file"
		[[ $reload == - ]] || (eval "$reload") >/dev/null 2>&1 & # in parallel; "not running" is fine
	done < <(consumers)
	wait
	log_info theme family="$1" mode="$mode"
}

main() {
	local family mode
	read -r family mode < <(current)
	case ${1:-} in
	set)
		[[ -n ${2:-} ]] || { usage >&2 && exit 2; }
		family=$2
		if [[ ${3:-} == --mode ]]; then
			[[ ${4:-} =~ ^(dark|light)$ ]] || { usage >&2 && exit 2; }
			mode=$4
		elif [[ -n ${3:-} ]]; then
			usage >&2 && exit 2
		fi
		apply "$family" "$mode"
		;;
	mode)
		case ${2:-} in
		dark | light) mode=$2 ;;
		toggle) [[ $mode == dark ]] && mode=light || mode=dark ;;
		*) usage >&2 && exit 2 ;;
		esac
		apply "$family" "$mode"
		;;
	list)
		[[ ${2:-} != --json ]] || exec python3 "$lib/theme_render.py" palettes
		local f name
		for f in "$themes"/*.toml; do
			name="$(basename "$f" .toml)"
			if [[ $name == "$family" ]]; then echo "* $name"; else echo "  $name"; fi
		done
		;;
	current) echo "$family $mode" ;;
	-h | --help) usage ;;
	*) usage >&2 && exit 2 ;;
	esac
}

main "$@"
