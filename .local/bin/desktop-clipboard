#!/usr/bin/env python3
"""The clipboard for the shell's history: what each copy was, and copying an entry back as that.

  desktop-clipboard watch               a JSON line for every copy from now on (X11: XFixes tells
                                        when the clipboard changes hands; Wayland: wl-paste --watch)
  desktop-clipboard store               the clipboard now, as one JSON line:
                                          {"kind": "text", "text": ...}            kept in memory
                                          {"kind": "image", "path": ..., "type"}   saved once, in
                                            $XDG_RUNTIME_DIR/desktop/clipboard (RAM, gone at logout)
                                          {"kind": "files", "paths": [...]}
                                        nothing for what a password manager marks as a password
  desktop-clipboard copy text           stdin, as text
  desktop-clipboard copy image <path>   the picture, as an image (pastes into a chat as one)
  desktop-clipboard copy files <path>...  as a file manager copies files: their file:// URIs as
                                        text/uri-list alone, so a chat or mail attaches them
"""
import ctypes
import ctypes.util
import hashlib
import json
import os
import subprocess
import sys
from urllib.parse import quote, unquote, urlparse

WAYLAND = bool(os.environ.get("WAYLAND_DISPLAY"))
# images: where the shell keeps its history (DESKTOP_CLIPBOARD_IMAGES, to outlast a reboot), else RAM
FOLDER = os.environ.get("DESKTOP_CLIPBOARD_IMAGES") or os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "desktop", "clipboard")
TEXT_TYPES = ("UTF8_STRING", "text/plain;charset=utf-8", "text/plain", "STRING", "TEXT")
IMAGE_TYPES = {"image/png": "png", "image/jpeg": "jpg", "image/webp": "webp", "image/gif": "gif", "image/bmp": "bmp"}
SECRET = "x-kde-passwordManagerHint"


def types():
    command = ["wl-paste", "--list-types"] if WAYLAND else ["xclip", "-selection", "clipboard", "-o", "-t", "TARGETS"]
    result = subprocess.run(command, capture_output=True)
    return [t.strip() for t in result.stdout.decode(errors="replace").splitlines() if t.strip()]


def read(kind):
    command = ["wl-paste", "--no-newline", "--type", kind] if WAYLAND else ["xclip", "-selection", "clipboard", "-o", "-t", kind]
    return subprocess.run(command, capture_output=True).stdout


def store():
    offered = types()
    if not offered or SECRET in offered:
        return None
    if "text/uri-list" in offered:
        uris = read("text/uri-list").decode(errors="replace").split()
        paths = [unquote(urlparse(u).path) for u in uris if u.startswith("file://")]
        if paths:
            return {"kind": "files", "paths": paths}
    image = next((t for t in IMAGE_TYPES if t in offered), None)
    if image:
        data = read(image)
        if data:
            os.makedirs(FOLDER, mode=0o700, exist_ok=True)
            path = os.path.join(FOLDER, hashlib.sha1(data).hexdigest()[:16] + "." + IMAGE_TYPES[image])
            if not os.path.exists(path):
                with open(path, "wb") as f:
                    f.write(data)
            return {"kind": "image", "path": path, "type": image}
    text_type = next((t for t in TEXT_TYPES if t in offered), None)
    if text_type:
        text = read(text_type).decode(errors="replace")
        if text.strip():
            return {"kind": "text", "text": text}
    return None


def report():
    entry = store()
    if entry:
        print(json.dumps(entry), flush=True)


def put(kind, data):
    # the copier stays behind serving the clipboard: it mustn't hold our output open
    quiet = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
    if WAYLAND:
        if kind == "text/uri-list":
            # wl-copy would offer text/plain beside it, and apps would paste the path instead
            if subprocess.run(["wl-copy-exact", kind], input=data, **quiet).returncode == 0:
                return
        subprocess.run(["wl-copy", "--type", kind], input=data, **quiet)
    else:
        subprocess.run(["xclip", "-selection", "clipboard", "-t", kind, "-i"], input=data, **quiet)


def copy(args):
    if args[:1] == ["text"]:
        put("UTF8_STRING" if not WAYLAND else "text/plain;charset=utf-8", sys.stdin.buffer.read())
    elif args[:1] == ["image"] and len(args) == 2:
        kind = next((t for t, ext in IMAGE_TYPES.items() if args[1].endswith("." + ext)), "image/png")
        with open(args[1], "rb") as f:
            put(kind, f.read())
    elif args[:1] == ["files"] and len(args) > 1:
        uris = "".join("file://" + quote(os.path.abspath(p), safe="/._~-") + "\r\n" for p in args[1:])
        put("text/uri-list", uris.encode())
    else:
        return usage()
    return 0


def watch_x11():
    """XFixes: a SelectionNotify event each time the clipboard gets a new owner (a copy)."""
    x11 = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
    xfixes = ctypes.cdll.LoadLibrary(ctypes.util.find_library("Xfixes") or "libXfixes.so.3")
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XDefaultRootWindow.restype = ctypes.c_ulong
    x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    x11.XInternAtom.restype = ctypes.c_ulong
    x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
    x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
    xfixes.XFixesQueryExtension.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)]
    xfixes.XFixesSelectSelectionInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong]
    display = x11.XOpenDisplay(None)
    if not display:
        print("desktop-clipboard: no X display", file=sys.stderr)
        return 1
    base, error = ctypes.c_int(), ctypes.c_int()
    if not xfixes.XFixesQueryExtension(display, ctypes.byref(base), ctypes.byref(error)):
        print("desktop-clipboard: no XFixes", file=sys.stderr)
        return 1
    clipboard = x11.XInternAtom(display, b"CLIPBOARD", 0)
    xfixes.XFixesSelectSelectionInput(display, x11.XDefaultRootWindow(display), clipboard, 1)  # SetSelectionOwnerNotifyMask
    event = ctypes.create_string_buffer(192)  # an XEvent
    while True:
        x11.XNextEvent(display, event)
        if ctypes.c_int.from_buffer(event).value == base.value:  # XFixesSelectionNotify
            report()


def watch():
    if WAYLAND:
        os.execvp("wl-paste", ["wl-paste", "--watch", os.path.abspath(sys.argv[0]), "store"])
    return watch_x11()


def usage():
    print(__doc__.strip(), file=sys.stderr)
    return 2


def main(args):
    if args == ["store"]:
        report()
        return 0
    if args == ["watch"]:
        return watch() or 0
    if args[:1] == ["copy"]:
        return copy(args[1:])
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
