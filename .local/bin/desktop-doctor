#!/usr/bin/env bash
# Health report for the desktop (PRD F19). Exit 1 if any check fails; warnings don't fail.
set -uo pipefail

repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
lib="$repo/.local/lib/desktop"
# shellcheck source-path=SCRIPTDIR/../.. source=.local/lib/desktop/ui.sh
source "$lib/ui.sh"

usage() { printf 'usage: desktop-doctor [--fix-hints]\n'; }

fix_hints=0 failures=0 display=''
problem() { # <message> <fix>
	bad "$1"
	((fix_hints)) && hint "$2"
	failures=$((failures + 1))
}

check_session() {
	local session
	# detect.sh exits on failure, so keep it in a subshell
	# shellcheck source-path=SCRIPTDIR/../.. source=.local/lib/desktop/log.sh
	if session="$( (source "$lib/log.sh" && source "$lib/detect.sh" && echo "$DESKTOP_WM $DESKTOP_DISPLAY") 2>/dev/null)"; then
		display=${session#* }
		ok "session: ${session% *} on $display"
	else
		problem 'session: no supported compositor or display' 'run inside an i3 or sway session'
	fi
}

check_deps() { # <display>
	local cmds=(qs kitty copyq notify-send wpctl brightnessctl playerctl gpu-screen-recorder stow)
	case $1 in
	x11) cmds+=(i3 i3bar i3lock xss-lock picom feh maim slop xclip st xrdb) ;;
	wayland) cmds+=(sway swaylock swayidle grim slurp wl-copy foot) ;;
	esac
	local c missing=()
	for c in "${cmds[@]}"; do command -v "$c" >/dev/null || missing+=("$c"); done
	if ((${#missing[@]})); then
		problem "deps: missing ${missing[*]}" "$repo/setup.sh"
	else
		ok "deps: ${#cmds[@]} commands found"
	fi
}

check_links() {
	local link broken=0
	while IFS= read -r -d '' link; do
		[[ $(readlink -m "$link") == "$repo"/* ]] && broken=$((broken + 1))
	done < <(find "$HOME" -xdev \( -path "$repo" -o -path "$HOME/.cache" \) -prune -o -xtype l -print0)
	if ((broken)); then
		problem "links: $broken broken link(s) into the repo" "$repo/setup.sh (relinks and drops stale links)"
	else
		ok 'links: no broken links'
	fi
}

check_repo() {
	local changes
	if ! changes="$(git -C "$repo" status --porcelain 2>/dev/null)"; then
		warn 'repo: not a git checkout here'
	elif [[ -n $changes ]]; then
		warn "repo: $(wc -l <<<"$changes") uncommitted change(s) in $repo"
	else
		ok 'repo: clean'
	fi
	# Before cutover the live desktop runs from ~/dot-files and must stay on main (PRD R8)
	local live="$HOME/dot-files" branch
	if [[ $live != "$repo" && -e $live/.git ]]; then
		branch="$(git -C "$live" branch --show-current 2>/dev/null)"
		[[ $branch == main ]] || warn "live repo $live is on '${branch:-detached}', expected main"
	fi
}

main() {
	while (($#)); do
		case $1 in
		-h | --help) usage && exit 0 ;;
		--fix-hints) fix_hints=1 ;;
		*) usage >&2 && exit 2 ;;
		esac
		shift
	done

	printf '%sdesktop doctor%s\n' "$bold" "$reset"
	check_session
	check_deps "$display"
	check_links
	check_repo

	if ((failures)); then
		printf '\n%s✗ %d problem(s)%s\n' "$red" "$failures" "$reset"
		exit 1
	fi
	printf '\n%s✓ healthy%s\n' "$green" "$reset"
}

main "$@"
