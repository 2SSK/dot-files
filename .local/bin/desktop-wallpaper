#!/usr/bin/env bash
# Set the wallpaper with a short cross-fade, or put the last one back. On Wayland awww draws it (its
# daemon started here when it isn't running; swaybg, without a fade, where there's no awww), on X11 feh.
#   desktop-wallpaper set <image>   fade from the current one to it, and remember it
#   desktop-wallpaper restore       draw the remembered one (login), no fade
#   desktop-wallpaper screens       redraw the login screen's background from it
#   desktop-wallpaper next-boot     while shutting down, with wallpaper.rotate "boot": pick the next
#                                   boot's, so the login screen and the desktop start on it (a user
#                                   service runs it as the session stops; a logout keeps the old one)
# The choice is ~/.local/state/desktop/wallpaper, a link the lock screen reads too. The login screen
# (sddm) can't read the home folder: packages/system.sh sddm gives us a background file of its,
# which set redraws.
# X11: feh, through a few half-size blended frames made in parallel (feh has no transitions).
# Wayland: awww fades by itself, over the time the shell's slow fades take twice (0.8 s).
set -euo pipefail

here="$(dirname "$(readlink -f "$0")")"
frames=(25 50 75)

# shellcheck source-path=SCRIPTDIR/.. source=.local/lib/desktop/screens.sh
source "$here/../lib/desktop/screens.sh"
# shellcheck source-path=SCRIPTDIR/.. source=.local/lib/desktop/state.sh
source "$here/../lib/desktop/state.sh"
state="$desktop_state"

draw() { # <image> [fade]
	if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
		feh --no-fehbg --bg-fill "$1"
	elif command -v awww >/dev/null; then
		if ! awww query >/dev/null 2>&1; then
			setsid -f awww-daemon >/dev/null 2>&1
			for _ in $(seq 30); do awww query >/dev/null 2>&1 && break; sleep 0.1; done
		fi
		awww img "$1" --transition-type "$([[ -n ${2:-} ]] && echo fade || echo none)" \
			--transition-duration 0.8 --transition-fps 60
	else # one swaybg at a time: the new one up before the old one goes
		local old
		old="$(pgrep -x swaybg || true)"
		setsid -f swaybg -m fill -i "$1" >/dev/null 2>&1
		sleep 0.3
		[[ -z $old ]] || kill $old 2>/dev/null || true
	fi
}

fade() { # <from> <to>: blended frames between them, then the new one
	[[ -z ${WAYLAND_DISPLAY:-} && -f $1 && $1 != "$2" ]] && command -v magick >/dev/null || return 0
	local dir pct
	dir="$(mktemp -d)"
	# shellcheck disable=SC2064 # expand now: dir is local
	trap "rm -rf '$dir'" RETURN
	for pct in "${frames[@]}"; do
		magick "$1" "$2" -resize '960x540^' -gravity center -extent 960x540 \
			-compose blend -define compose:args="$pct" -composite "$dir/$pct.jpg" &
	done
	wait
	for pct in "${frames[@]}"; do
		[[ -s $dir/$pct.jpg ]] && feh --no-fehbg --bg-fill "$dir/$pct.jpg" && sleep 0.05
	done
}

# The login screen's background: sddm's shared folder is ours (a new file, then moved in place).
# Skipped when packages/system.sh hasn't set it up.
screens() {
	local wallpaper sddm="${DESKTOP_SDDM_DIR:-/var/lib/desktop/sddm}"
	wallpaper="$(current_wallpaper)"
	[[ -d $sddm && -w $sddm ]] || return 0
	login_background "$wallpaper" "$sddm/.background.new.jpg" && mv -f "$sddm/.background.new.jpg" "$sddm/background.jpg"
}

# The images rotation picks from: wallpaper.folders in shell.json, a folder deep, as the shell does
images() {
	local conf="${XDG_CONFIG_HOME:-$HOME/.config}/desktop/shell.json" dir
	jq -r '(.wallpaper.folders // ["~/.local/share/desktop/wallpapers", "~/Wallpaper-Bank"])[]' "$conf" 2>/dev/null |
		while IFS= read -r dir; do
			dir="${dir/#\~/$HOME}"
			[[ -d $dir ]] && find -L "$dir" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \)
		done
}

recolour() { # matugen's theme follows the wallpaper (and is applied when it's the theme in use)
	command -v matugen >/dev/null || return 0
	setsid -f theme wallpaper >/dev/null 2>&1
}

next_boot() {
	[[ $(systemctl is-system-running 2>/dev/null || true) == stopping ]] || return 0
	local conf="${XDG_CONFIG_HOME:-$HOME/.config}/desktop/shell.json"
	[[ $(jq -r '.wallpaper.rotate // "off"' "$conf" 2>/dev/null) == boot ]] || return 0
	local family current next all=() pool=() file
	read -r family _ < <(current_theme)
	current="$(current_wallpaper)"
	mapfile -t all < <(images)
	# from the theme's own folder (~/Wallpaper-Bank/<family>/) when it has a choice, as the shell does
	for file in "${all[@]}"; do [[ $(basename "$(dirname "$file")") == "$family" ]] && pool+=("$file"); done
	((${#pool[@]} > 1)) || pool=("${all[@]}")
	next="$(printf '%s\n' "${pool[@]}" | grep -vxF -- "$current" | shuf -n 1 || true)"
	[[ -n $next ]] || return 0
	ln -sfn "$next" "$state/wallpaper"
	date +%s >"$state/wallpaper-changed"
	screens
	# shutting down: matugen's colours made and rendered for the next login, no app reloaded
	if command -v matugen >/dev/null && [[ $family == matugen ]]; then
		python3 "$here/../lib/desktop/matugen_theme.py" "$next" "$state/themes/matugen.toml" &&
			python3 "$here/../lib/desktop/theme_render.py" render matugen "$(current_theme | cut -d' ' -f2)"
	fi
	return 0
}

case ${1:-} in
screens) screens ;;
next-boot) next_boot ;;
set)
	[[ -f ${2:-} ]] || { echo "desktop-wallpaper: not an image: ${2:-}" >&2 && exit 2; }
	mkdir -p "$state"
	from="$(current_wallpaper)"
	fade "$from" "$2"
	draw "$2" fade
	ln -sfn "$2" "$state/wallpaper"
	date +%s >"$state/wallpaper-changed"
	screens
	recolour
	;;
restore)
	current="$(current_wallpaper)"
	draw "$current"
	;;
*)
	echo "usage: desktop-wallpaper set <image> | restore | screens | next-boot" >&2
	exit 2
	;;
esac
