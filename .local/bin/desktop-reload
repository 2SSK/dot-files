#!/usr/bin/env bash
# The shell restarted on its config, once that is checked to load in a throwaway session: a config
# that doesn't load leaves the running shell as it is. Never while the screen is locked.
#   desktop-reload
set -uo pipefail

lib="$(dirname "$(readlink -f "$0")")/../lib/desktop"
if [[ $(timeout 3 qs -c desktop ipc call lock locked 2>/dev/null) == true ]]; then
	echo "desktop-reload: the screen is locked; unlock first" >&2
	exit 1
fi
if ! "$lib/shell-check.sh"; then
	echo "desktop-reload: not reloaded, the running shell stays as it is" >&2
	exit 1
fi
if systemctl --user is-active -q desktop-shell.service; then
	systemctl --user restart desktop-shell.service
else # i3, or a shell not started by the service
	qs kill -c desktop >/dev/null 2>&1
	setsid -f qs -c desktop --no-duplicate --daemonize >/dev/null 2>&1
fi
for _ in $(seq 40); do
	timeout 2 qs -c desktop ipc call lock locked >/dev/null 2>&1 && { echo "desktop-reload: done" && exit 0; }
	sleep 0.5
done
echo "desktop-reload: the shell didn't come back; see: qs -c desktop log" >&2
exit 1
