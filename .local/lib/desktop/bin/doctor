#!/usr/bin/env bash
# Checks the parts of the desktop that have failed silently before, and says what to do about each.
#   desktop doctor        exit 1 when anything is wrong
set -uo pipefail

failed=0
ok() { printf '  \e[32m✓\e[0m %s\n' "$1"; }
bad() { printf '  \e[31m✗\e[0m %s\n      %s\n' "$1" "$2" && failed=1; }
age() { ps -o etimes= -p "$1" 2>/dev/null | tr -d ' '; } # seconds a process has run
ipc() { timeout 3 qs -c desktop ipc call "$@" 2>/dev/null; }

# Arch deletes the running kernel's modules when it upgrades: until a reboot nothing new loads
# (a Bluetooth keyboard connects but never types: uhid), unless kernel-modules-hook kept them
if [[ -d ${DESKTOP_MODULES_DIR:-/usr/lib/modules}/$(uname -r) ]]; then
	ok "kernel modules in place"
else
	bad "kernel upgraded: $(uname -r)'s modules are gone (Bluetooth keyboards, USB drives…)" "reboot"
fi

if pgrep -fx 'qs -c desktop.*' >/dev/null; then
	ok "shell running"
else
	bad "shell not running" "systemctl --user restart desktop-shell (i3: qs -c desktop --daemonize)"
fi

if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
	state="$(ipc lock state)"
	if [[ -z $state ]]; then
		bad "lock: the shell doesn't answer" "desktop reload"
	elif jq -e '(.curtain or .locked) and (.secure | not)' <<<"$state" >/dev/null; then
		bad "lock: stuck half-way ($state)" "desktop reload"
	else
		ok "lock ready"
	fi

	# one swayidle for this display, not waiting on a command (it then neither locks nor undims)
	idle=""
	for p in $(pgrep -u "$(id -u)" -x swayidle); do
		tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | grep -qx "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" && idle+="$p "
	done
	read -ra idle <<<"$idle"
	if ((${#idle[@]} != 1)); then
		bad "idle: ${#idle[@]} swayidle for this display" "desktop reload (the shell runs exactly one)"
	else
		stuck=""
		for c in $(pgrep -P "${idle[0]}"); do (($(age "$c") > 60)) && stuck="$(ps -o args= -p "$c")"; done
		if [[ -n $stuck ]]; then
			bad "idle: swayidle waits on '$stuck'" "nothing locks or undims meanwhile; kill that command"
		else
			ok "idle and lock-on-sleep listening"
		fi
	fi

	if ! pgrep -f 'wl-paste --watch .*desktop/bin/clipboard store' >/dev/null; then
		bad "clipboard history: not watching" "desktop reload"
	else
		stuck=""
		for c in $(pgrep -f '^python3 .*desktop/bin/clipboard store$'); do (($(age "$c") > 30)) && stuck=1; done
		if [[ -n $stuck ]]; then
			bad "clipboard history: stuck on one copy" "pkill -f '^python3 .*desktop/bin/clipboard store\$'"
		else
			ok "clipboard history recording"
		fi
	fi

	if [[ $(sway --version 2>/dev/null) == swayfx* ]]; then
		if [[ -e ${XDG_STATE_HOME:-$HOME/.local/state}/desktop/sway-effects.conf ]]; then
			ok "SwayFX effects in the config"
		else
			bad "SwayFX effects not linked: blur goes after a reload" "run desktop effects"
		fi
	fi
fi

if bluetoothctl list 2>/dev/null | grep -q Controller; then
	if pgrep -f 'bluetoothctl --agent' >/dev/null; then
		ok "Bluetooth pairing agent running"
	else
		bad "no Bluetooth pairing agent: keyboards and earbuds can't pair" "desktop reload (the shell runs one)"
	fi
fi

if compgen -G '/sys/class/power_supply/BAT*' >/dev/null; then
	if cmp -s "$(dirname "$(readlink -f "$0")")/../../../../system/etc/systemd/logind.conf.d/10-lid.conf" /etc/systemd/logind.conf.d/10-lid.conf; then
		ok "closing the lid locks (no suspend)"
	else
		bad "closing the lid suspends: the lid setting isn't installed" "packages/system.sh lid"
	fi
fi

errors="$(timeout 5 qs -c desktop log 2>/dev/null | grep -cE 'TypeError|ReferenceError|is not defined|is not a type|Invalid property assignment')"
if ((errors)); then
	bad "shell log: $errors script errors since it started" "qs -c desktop log | grep -E 'TypeError|ReferenceError'"
else
	ok "shell log clean"
fi

exit "$failed"
