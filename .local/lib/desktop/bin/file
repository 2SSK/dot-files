#!/usr/bin/env bash
# Open a file with what suits it, or copy its path or its content (the launcher's file picker).
#   desktop file open <file>      text and code: $EDITOR (nvim) in $TERMINAL (kitty); web pages,
#                                 PDFs and SVGs: a new tab of the browser that's running, else of
#                                 the default one; anything else: its default application
#   desktop file file <file>      the file itself, to paste as an attachment (Teams, WhatsApp, mail):
#                                 its file:// URI as text/uri-list alone; with text beside it,
#                                 apps paste the path instead
#   desktop file path <file>      the full path, as text
#   desktop file content <file>   text as text, an image as an image, anything else as the file
#                                 itself (pastes as an attachment)
#   desktop file find [query]     up to 60 files and folders whose names hold every word typed
#                                 (as Nautilus searches: not scattered letters, not the folder they're
#                                 in), names starting with it first, then the shorter. The launcher
#                                 starts it at ~/:
#                                   ~/ (or nothing): your files changed in the last week, newest first
#                                   ~/word (or word): your files matching it
#                                   ~/.x: your dotfiles and dot-folders (in home itself)
#                                   a path (~/.config/ni, /etc/pac, /tmp/): in that folder, what
#                                   matches the rest, hidden ones too (folders end in /)
#                                 Your files are home's visible ones: dot-folders (.config, .cache,
#                                 .local: settings and app caches) and dependency folders aren't
#                                 searched unless you type their path; fd's ignore file
#                                 (~/.config/fd/ignore) leaves out more, such as tool data in ~/go.
set -euo pipefail

usage() {
	echo "usage: desktop file open|file|path|content <file> | find [query]" >&2
	exit 2
}

# a running browser's command, else the default browser's, else nothing
browser() {
	local proc cmd default
	for proc in brave:brave firefox:firefox chromium:chromium chrome:google-chrome-stable librewolf:librewolf vivaldi-bin:vivaldi zen:zen-browser; do
		cmd=${proc#*:}
		pgrep -x "${proc%%:*}" >/dev/null && command -v "$cmd" >/dev/null && echo "$cmd" && return
	done
	default="$(xdg-settings get default-web-browser 2>/dev/null || true)"
	for cmd in brave firefox chromium google-chrome-stable librewolf vivaldi zen-browser; do
		[[ $default == *"${cmd%%-*}"* ]] && command -v "$cmd" >/dev/null && echo "$cmd" && return
	done
	return 0
}

editable() { # <mime type>
	case $1 in
	text/html | application/xhtml+xml) return 1 ;;
	text/* | application/json | application/javascript | application/x*yaml | application/toml | application/x-shellscript | application/xml | inode/x-empty) return 0 ;;
	*) return 1 ;;
	esac
}

# <folder> [query] [fd arguments...]: what's under the folder whose name holds every word of the
# query (fzf --exact on the name alone), names starting with it first; the folder in front. Dependency
# folders are left out; dot-folders too, unless --hidden. A folder's list is kept 2 minutes (in
# memory, under $XDG_RUNTIME_DIR), so typing filters it rather than rescanning.
search() {
	local dir=${1%/} query=$2 list
	shift 2
	list="${XDG_RUNTIME_DIR:-/tmp}/desktop/files/$(printf '%s ' "$dir" "$@" | md5sum | cut -c1-16)"
	if [[ ! -s $list || $(($(date +%s) - $(stat -c %Y "$list"))) -ge 120 ]]; then
		mkdir -p "${list%/*}"
		# each path beside its name (a folder's without its /): the name is matched, the path kept
		(cd "${dir:-/}" && fd --exclude node_modules --exclude __pycache__ --exclude target "$@" . 2>/dev/null) |
			awk '{ n = $0; sub(/\/$/, "", n); sub(/.*\//, "", n); print n "\t" $0 }' >"$list.new" || true
		mv "$list.new" "$list"
	fi
	if [[ -z $query ]]; then
		cut -f2- "$list"
	else
		fzf --filter "$query" --exact --delimiter '\t' --nth 1 --tiebreak begin,length <"$list" | cut -f2-
	fi | sed "s|^\./||; s|^|$dir/|"
}

recent() { # your files changed lately, newest first; meanwhile your files' list, for the first word
	(search "$HOME" "" >/dev/null 2>&1 &)
	search "$HOME" "" --type f --changed-within 7d | tr '\n' '\0' | xargs -0r stat -c '%Y %n' | sort -rn | cut -d' ' -f2-
}

find_files() { # [query]
	local query=${1:-} dir
	query="${query/#\~/$HOME}"
	# a folder's path: in that folder (hidden too), what matches what follows its last /
	in_folder() {
		dir="${query%/*}"
		[[ -d ${dir:-/} ]] || return 0
		search "${dir:-/}" "${query##*/}" --hidden --max-depth 4
	}
	case $query in
	"" | "$HOME" | "$HOME/") recent ;;
	"$HOME"/*/*) in_folder ;;
	"$HOME"/.*) search "$HOME" "${query#"$HOME/"}" --hidden --max-depth 1 --glob '.*' ;; # a dotfile in home
	"$HOME"/*) search "$HOME" "${query#"$HOME/"}" ;;                                         # your files
	/*/*) in_folder ;;
	/*) search / "${query#/}" --hidden --max-depth 2 ;; # /e: from the top
	*) search "$HOME" "$query" ;;
	esac | head -60
}

if [[ ${1:-} == find ]]; then
	(($# <= 2)) || usage
	find_files "${2:-}"
	exit
fi
(($# == 2)) || usage
action=$1
[[ -e $2 ]] || { echo "desktop file: no such file: $2" >&2 && exit 1; }
file="$(realpath -- "$2")"
mime="$(file --brief --mime-type -- "$file")"

case $action in
open)
	if [[ -d $file ]]; then
		exec "${TERMINAL:-kitty}" --directory "$file"
	elif [[ $mime == text/html || $mime == application/xhtml+xml || $mime == application/pdf || $mime == image/svg+xml ]] && cmd="$(browser)" && [[ -n $cmd ]]; then
		exec "$cmd" --new-tab "file://$file"
	elif editable "$mime"; then
		exec "${TERMINAL:-kitty}" -e "${EDITOR:-nvim}" "$file"
	else
		exec xdg-open "$file"
	fi
	;;
# copies go through desktop clipboard, as the shell's own do
file) desktop clipboard copy files "$file" ;;
path) printf '%s' "$file" | desktop clipboard copy text ;;
content)
	if editable "$mime"; then
		desktop clipboard copy text <"$file"
	elif [[ $mime == image/* ]]; then
		desktop clipboard copy image "$file" "$mime"
	else
		desktop clipboard copy files "$file"
	fi
	;;
*) usage ;;
esac
