#!/usr/bin/env bash
# Lock the screen in the desktop theme and wait until it's unlocked. xss-lock runs it (i3's
# autostart) for `loginctl lock-session`, a closed lid and before sleep. X11: i3lock-color, minimal:
# the wallpaper softly blurred and dimmed, a large light clock (12-hour, as the bar) and the date,
# a small faint ring that lights up as you type, a quiet hint at the bottom; plain i3lock gets the
# background colour.
# Wayland (sway): the shell's own lock screen (Quickshell's session lock), else swaylock.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR/../../../.. source=.local/lib/desktop/state.sh
source "$(dirname "$(readlink -f "$0")")/../state.sh"

# the theme's colours (rrggbb), in one read; tokyonight's without a theme
palette="$desktop_state/theme/palette.json"
read -r bg fg primary error < <(jq -r '.ui | [.bg, .fg, .primary, .error] | map(ltrimstr("#")) | join(" ")' "$palette" 2>/dev/null) ||
	read -r bg fg primary error <<<"1a1b26 c0caf5 7aa2f7 f7768e"
# the font collection's (display for the clock, monospace for the rest, as the bar)
display="$(jq -r '.fonts.display // "Inter Display"' "$palette" 2>/dev/null || echo 'Inter Display')"
mono="$(jq -r '.fonts.mono // "JetBrainsMono Nerd Font"' "$palette" 2>/dev/null || echo 'JetBrainsMono Nerd Font')"

if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
	# the shell's session lock; once it holds the screen this returns (sleep may go ahead). About 4.5 s,
	# past the shell's own 4 s give-up, so swaylock never races a lock still on its way
	if qs -c desktop ipc call lock lock >/dev/null 2>&1; then
		for _ in $(seq 30); do
			[[ $(qs -c desktop ipc call lock locked 2>/dev/null) == true ]] && exit 0
			sleep 0.1
		done
	fi
	# no shell: swaylock instead
	exec swaylock --color "$bg" --inside-color "${bg}cc" --ring-color "$primary" --key-hl-color "$fg" \
		--ring-wrong-color "$error" --text-color "$fg" --indicator-radius 80
fi

# The wallpaper, blurred (at a quarter size: fast, and as soft) and dimmed in the theme's
# background colour, cached until either changes
backdrop() {
	local wallpaper out
	wallpaper="$(current_wallpaper)"
	[[ -f $wallpaper ]] && command -v magick >/dev/null || return 1
	# one per wallpaper and colour: a switch to an older picture still gets its own
	out="${XDG_CACHE_HOME:-$HOME/.cache}/desktop/lock-$bg-$(printf %s "$wallpaper" | md5sum | cut -c1-12).png"
	if [[ ! -s $out || $wallpaper -nt $out ]]; then
		mkdir -p "${out%/*}"
		magick "$wallpaper" -resize '2560x1440^' -gravity center -extent 2560x1440 -scale 25% -blur 0x10 -resize 400% \
			\( -size 2560x1440 "xc:#$bg" -alpha set -channel A -evaluate set 55% +channel \) -composite -define png:compression-level=1 "$out.tmp.png" &&
			mv "$out.tmp.png" "$out" || return 1
	fi
	echo "$out"
}

# Locked already (idle, then the lid, then sleep: each asks): wait on that lock, don't stack another
# (a second i3lock under the first needs the password twice)
if pgrep -u "$UID" -x i3lock >/dev/null; then
	while pgrep -u "$UID" -x i3lock >/dev/null; do sleep 0.5; done
	exit 0
fi

if i3lock --version 2>&1 | grep -q 'i3lock-color\|\.c\.'; then
	image=(--blur 8)
	if picture="$(backdrop)"; then image=(--image "$picture" --fill); fi
	# Minimal, as the bar: a large clock (24-hour) in the display font, the date under it and a quiet
	# hint at the bottom in the monospace; a ring, faint until a key lights
	# it in the accent colour (accent while checking, red when wrong). i3lock never shows the typed
	# characters.
	exec i3lock --nofork --ignore-empty-password --show-failed-attempts "${image[@]}" --color "$bg" \
		--clock --force-clock --time-str '%H:%M' --date-str '%A %-d %B' --time-size 120 --date-size 18 \
		--time-font "$display" --date-font "$mono" --greeter-font "$mono" --verif-font "$mono" --wrong-font "$mono" --layout-font "$mono" \
		--time-color "${fg}ff" --date-color "${fg}aa" --time-pos 'x+w/2:y+h/2-40' --date-pos 'tx:ty+48' \
		--greeter-text 'type to unlock' --greeter-size 13 --greeter-color "${fg}55" --greeter-pos 'x+w/2:y+h-56' \
		--ind-pos 'x+w/2:y+h/2+140' --radius 34 --ring-width 4 --inside-color "${bg}00" --ring-color "${fg}22" \
		--line-uses-inside --separator-color 00000000 --keyhl-color "${primary}ff" --bshl-color "${error}ff" \
		--insidever-color "${bg}00" --ringver-color "${primary}ff" --insidewrong-color "${bg}00" --ringwrong-color "${error}ff" \
		--verif-text '' --wrong-text 'wrong password' --noinput-text '' --verif-size 14 --wrong-size 14 \
		--verif-color "${fg}cc" --wrong-color "${error}ff" --verif-pos 'ix:iy+62' --wrong-pos 'ix:iy+62' \
		--pass-media-keys --pass-volume-keys --pass-screen-keys
fi
exec i3lock --nofork --ignore-empty-password --show-failed-attempts --color "$bg"
