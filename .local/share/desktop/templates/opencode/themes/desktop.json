{
  "$$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "$primary",
    "secondary": "$secondary",
    "accent": "$accent",
    "error": "$error",
    "warning": "$warning",
    "success": "$success",
    "info": "$c6",
    "text": "$fg",
    "textMuted": "$fg_muted",
    "background": "none",
    "backgroundPanel": "$surface",
    "backgroundElement": "$surface",
    "border": "$border",
    "borderActive": "$border_active",
    "borderSubtle": "$surface",
    "diffAdded": "$success",
    "diffRemoved": "$error",
    "diffContext": "$fg_muted",
    "diffHunkHeader": "$secondary",
    "diffHighlightAdded": "$success",
    "diffHighlightRemoved": "$error",
    "diffAddedBg": "$surface",
    "diffRemovedBg": "$surface",
    "diffContextBg": "none",
    "diffLineNumber": "$fg_muted",
    "diffAddedLineNumberBg": "$surface",
    "diffRemovedLineNumberBg": "$surface",
    "markdownText": "$fg",
    "markdownHeading": "$primary",
    "markdownLink": "$primary",
    "markdownLinkText": "$c6",
    "markdownCode": "$success",
    "markdownBlockQuote": "$fg_muted",
    "markdownEmph": "$warning",
    "markdownStrong": "$accent",
    "markdownHorizontalRule": "$border",
    "markdownListItem": "$primary",
    "markdownListEnumeration": "$c6",
    "markdownImage": "$primary",
    "markdownImageText": "$c6",
    "markdownCodeBlock": "$fg",
    "syntaxComment": "$fg_muted",
    "syntaxKeyword": "$secondary",
    "syntaxFunction": "$primary",
    "syntaxVariable": "$fg",
    "syntaxString": "$success",
    "syntaxNumber": "$accent",
    "syntaxType": "$warning",
    "syntaxOperator": "$c6",
    "syntaxPunctuation": "$fg_muted"
  }
}
