/* Generated by theme_render.py ($family $mode); edit the theme or this template, not the output.
   Linked as ~/.config/rofi/theme.rasi, which ~/.config/rofi/config.rasi imports. */
* {
	bg: $bg;
	bg-alt: $bg_alt;
	surface: $surface;
	overlay: $overlay;
	fg: $fg;
	fg-muted: $fg_muted;
	primary: $primary;
	on-primary: $on_primary;
	error: $error;
	font: "$font_mono 11";
	mono: "$font_mono 10";
	ui: "$font_ui 11";
}
