{
  "$$comment": "Generated by theme_render.py ($family $mode): VSCodium's colours, merged into its settings by desktop-vscodium.",
  "workbench.colorCustomizations": {
    "focusBorder": "$border_active",
    "foreground": "$fg",
    "descriptionForeground": "$fg_muted",
    "errorForeground": "$error",
    "widget.border": "$border",
    "widget.shadow": "#00000040",
    "selection.background": "$selection",
    "icon.foreground": "$fg_muted",
    "sash.hoverBorder": "$border_active",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "$overlay",
    "scrollbarSlider.hoverBackground": "$border",
    "scrollbarSlider.activeBackground": "$border_active",
    "progressBar.background": "$primary",
    "badge.background": "$primary",
    "badge.foreground": "$on_primary",
    "titleBar.activeBackground": "$bg",
    "titleBar.activeForeground": "$fg_muted",
    "titleBar.inactiveBackground": "$bg",
    "titleBar.inactiveForeground": "$fg_muted",
    "titleBar.border": "$bg",
    "menu.background": "$surface",
    "menu.foreground": "$fg",
    "menu.selectionBackground": "$selection",
    "menu.border": "$border",
    "editor.background": "$bg",
    "editor.foreground": "$fg",
    "editorLineNumber.foreground": "$overlay",
    "editorLineNumber.activeForeground": "$primary",
    "editorCursor.foreground": "$primary",
    "editor.lineHighlightBackground": "$bg_alt",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "$selection",
    "editor.inactiveSelectionBackground": "$surface",
    "editor.wordHighlightBackground": "$surface",
    "editor.findMatchBackground": "$overlay",
    "editor.findMatchHighlightBackground": "$surface",
    "editorBracketMatch.background": "$surface",
    "editorBracketMatch.border": "$border_active",
    "editorWhitespace.foreground": "$overlay",
    "editorIndentGuide.background1": "$surface",
    "editorRuler.foreground": "$surface",
    "editorGutter.background": "$bg",
    "editorGutter.addedBackground": "$success",
    "editorGutter.modifiedBackground": "$warning",
    "editorGutter.deletedBackground": "$error",
    "editorError.foreground": "$error",
    "editorWarning.foreground": "$warning",
    "editorInfo.foreground": "$c6",
    "editorHint.foreground": "$fg_muted",
    "editorWidget.background": "$surface",
    "editorWidget.border": "$border",
    "editorHoverWidget.background": "$surface",
    "editorHoverWidget.border": "$border",
    "editorSuggestWidget.background": "$surface",
    "editorSuggestWidget.border": "$border",
    "editorSuggestWidget.selectedBackground": "$selection",
    "editorSuggestWidget.highlightForeground": "$primary",
    "editorGroup.border": "$border",
    "editorGroupHeader.tabsBackground": "$bg",
    "editorGroupHeader.noTabsBackground": "$bg",
    "editorOverviewRuler.border": "#00000000",
    "peekView.border": "$border_active",
    "peekViewEditor.background": "$bg_alt",
    "peekViewResult.background": "$surface",
    "peekViewTitle.background": "$surface",
    "tab.activeBackground": "$bg",
    "tab.activeForeground": "$fg",
    "tab.activeBorderTop": "$primary",
    "tab.inactiveBackground": "$bg",
    "tab.inactiveForeground": "$fg_muted",
    "tab.border": "$bg",
    "tab.hoverBackground": "$bg_alt",
    "sideBar.background": "$bg",
    "sideBar.foreground": "$fg",
    "sideBar.border": "$border",
    "sideBarTitle.foreground": "$fg_muted",
    "sideBarSectionHeader.background": "$bg",
    "sideBarSectionHeader.border": "$bg",
    "list.activeSelectionBackground": "$selection",
    "list.activeSelectionForeground": "$fg",
    "list.inactiveSelectionBackground": "$surface",
    "list.hoverBackground": "$bg_alt",
    "list.focusOutline": "#00000000",
    "list.highlightForeground": "$primary",
    "tree.indentGuidesStroke": "$surface",
    "gitDecoration.modifiedResourceForeground": "$warning",
    "gitDecoration.untrackedResourceForeground": "$success",
    "gitDecoration.deletedResourceForeground": "$error",
    "gitDecoration.ignoredResourceForeground": "$overlay",
    "panel.background": "$bg",
    "panel.border": "$border",
    "panelTitle.activeBorder": "$primary",
    "panelTitle.activeForeground": "$fg",
    "panelTitle.inactiveForeground": "$fg_muted",
    "statusBar.background": "$bg",
    "statusBar.foreground": "$fg_muted",
    "statusBar.border": "$bg",
    "statusBar.noFolderBackground": "$bg",
    "statusBar.debuggingBackground": "$warning",
    "statusBar.debuggingForeground": "$bg",
    "statusBarItem.remoteBackground": "$bg",
    "statusBarItem.remoteForeground": "$primary",
    "activityBar.background": "$bg",
    "activityBar.foreground": "$fg",
    "activityBar.border": "$bg",
    "input.background": "$surface",
    "input.foreground": "$fg",
    "input.border": "$border",
    "input.placeholderForeground": "$fg_muted",
    "inputOption.activeBorder": "$border_active",
    "dropdown.background": "$surface",
    "dropdown.border": "$border",
    "button.background": "$primary",
    "button.foreground": "$on_primary",
    "button.secondaryBackground": "$surface",
    "button.secondaryForeground": "$fg",
    "checkbox.background": "$surface",
    "checkbox.border": "$border",
    "quickInput.background": "$surface",
    "quickInputList.focusBackground": "$selection",
    "pickerGroup.foreground": "$primary",
    "pickerGroup.border": "$border",
    "notifications.background": "$surface",
    "notifications.border": "$border",
    "notificationCenterHeader.background": "$surface",
    "textLink.foreground": "$primary",
    "textLink.activeForeground": "$accent",
    "terminal.background": "$bg",
    "terminal.foreground": "$fg",
    "terminalCursor.foreground": "$primary",
    "terminal.ansiBlack": "$c0",
    "terminal.ansiRed": "$c1",
    "terminal.ansiGreen": "$c2",
    "terminal.ansiYellow": "$c3",
    "terminal.ansiBlue": "$c4",
    "terminal.ansiMagenta": "$c5",
    "terminal.ansiCyan": "$c6",
    "terminal.ansiWhite": "$c7",
    "terminal.ansiBrightBlack": "$c8",
    "terminal.ansiBrightRed": "$c9",
    "terminal.ansiBrightGreen": "$c10",
    "terminal.ansiBrightYellow": "$c11",
    "terminal.ansiBrightBlue": "$c12",
    "terminal.ansiBrightMagenta": "$c13",
    "terminal.ansiBrightCyan": "$c14",
    "terminal.ansiBrightWhite": "$c15",
    "diffEditor.insertedTextBackground": "${success}26",
    "diffEditor.removedTextBackground": "${error}26"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "$fg_muted",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "string",
          "string.quoted",
          "string.template"
        ],
        "settings": {
          "foreground": "$success"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language",
          "constant.character",
          "constant.other"
        ],
        "settings": {
          "foreground": "$accent"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "storage.modifier",
          "keyword.control"
        ],
        "settings": {
          "foreground": "$secondary"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function",
          "meta.function-call",
          "variable.function"
        ],
        "settings": {
          "foreground": "$primary"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "entity.name.class",
          "support.type",
          "support.class",
          "storage.type",
          "entity.other.inherited-class"
        ],
        "settings": {
          "foreground": "$warning"
        }
      },
      {
        "scope": [
          "variable.parameter",
          "variable.language",
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "$c6"
        }
      },
      {
        "scope": [
          "entity.name.tag",
          "invalid"
        ],
        "settings": {
          "foreground": "$error"
        }
      },
      {
        "scope": [
          "punctuation",
          "keyword.operator",
          "meta.brace"
        ],
        "settings": {
          "foreground": "$fg_muted"
        }
      },
      {
        "scope": [
          "variable",
          "meta.definition.variable"
        ],
        "settings": {
          "foreground": "$fg"
        }
      },
      {
        "scope": [
          "markup.heading",
          "entity.name.section"
        ],
        "settings": {
          "foreground": "$primary",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.bold"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.italic"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "markup.inline.raw",
          "markup.fenced_code"
        ],
        "settings": {
          "foreground": "$accent"
        }
      },
      {
        "scope": [
          "markup.underline.link"
        ],
        "settings": {
          "foreground": "$c6"
        }
      },
      {
        "scope": [
          "markup.inserted"
        ],
        "settings": {
          "foreground": "$success"
        }
      },
      {
        "scope": [
          "markup.deleted"
        ],
        "settings": {
          "foreground": "$error"
        }
      },
      {
        "scope": [
          "markup.changed"
        ],
        "settings": {
          "foreground": "$warning"
        }
      }
    ]
  }
}
