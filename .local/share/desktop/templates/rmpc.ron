// Generated by theme_render.py ($family $mode); edit the theme or this template, not the output.
// Based on rmpc's default theme (`rmpc theme`, rmpc 0.11, BSD-3-Clause, (c) mierak) with its
// colours replaced by desktop theme roles. ~/.config/rmpc/config.ron loads it (theme:).
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: None,
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "${accent}"),
    preview_metadata_group_style: (fg: "${accent}", modifiers: "Bold"),
    highlighted_item_style: (fg: "${success}", modifiers: "Bold"),
    current_item_style: (fg: "${primary}", bg: "${surface}", modifiers: "Bold"),
    borders_style: (fg: "${border}"),
    highlight_border_style: (fg: "${accent}"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "${primary}", bg: "${bg_alt}"),
        warn: (fg: "${accent}", bg: "${bg_alt}"),
        error: (fg: "${error}", bg: "${bg_alt}"),
        debug: (fg: "${success}", bg: "${bg_alt}"),
        trace: (fg: "${secondary}", bg: "${bg_alt}"),
    ),
    progress_bar: (
        symbols: ["", "━", "━", "┄", ""],
        track_style: (fg: "${overlay}"),
        elapsed_style: (fg: "${accent}"),
        thumb_style: (fg: "${primary}"),
        use_track_when_empty: true,
    ),
    scrollbar: None,
    tab_bar: (
        active_style: (fg: "${accent}", bg: "${surface}", modifiers: "Bold"),
        inactive_style: (fg: "${fg_muted}"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Title), style: (fg: "${fg}"), default: (kind: Property(Filename), style: (fg: "${fg_muted}"))),
            label_prop: (kind: Text("Title")),
            width: "50%",
        ),
        (
            prop: (kind: Property(Artist), style: (fg: "${accent}"), default: (kind: Text("Unknown Artist"), style: (fg: "${fg_muted}"))),
            label_prop: (kind: Text("Artist")),
            width: "40%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "${warning}"), default: (kind: Text("-"))),
            label_prop: (kind: Text("Duration")),
            width: "10%",
            alignment: Right,
        ),
    ],
    // One rounded header box (state and time | title and artist | volume and modes), the tab bar
    // between two rules, the tab content, and a thin progress line.
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                borders: "ALL",
                border_symbols: Rounded,
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (size: "30%", pane: Component("np_left")),
                        (size: "40%", pane: Component("np_center")),
                        (size: "30%", pane: Component("np_right")),
                    ],
                ),
            ),
            (size: "1", pane: Pane(Empty())),
            (size: "3", borders: "TOP | BOTTOM", pane: Pane(Tabs)),
            (size: "1", pane: Pane(Empty())),
            (size: "100%", pane: Pane(TabContent)),
            (size: "1", pane: Pane(Empty())),
            (size: "1", pane: Pane(ProgressBar)),
        ],
    ),
    components: {
        "np_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(" ")), (kind: Property(Status(StateV2(playing_label: "▶", paused_label: "❚❚", stopped_label: "■"))), style: (fg: "${primary}", modifiers: "Bold"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [
                    (kind: Text(" ")),
                    (kind: Property(Status(Elapsed)), style: (fg: "${fg}")),
                    (kind: Text("/"), style: (fg: "${fg_muted}")),
                    (kind: Property(Status(Duration)), style: (fg: "${fg}")),
                ], align: Left))),
            ],
        ),
        "np_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Property(Song(Title)), style: (fg: "${fg}", modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "${fg}", modifiers: "Bold")))], align: Center))),
                (size: "1", pane: Pane(Property(content: [(kind: Property(Song(Artist)), style: (fg: "${accent}", modifiers: "Bold"),
                    default: (kind: Text("Unknown Artist"), style: (fg: "${fg_muted}")))], align: Center))),
            ],
        ),
        "np_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Pane(Property(content: [
                    (kind: Text("Vol: "), style: (fg: "${warning}", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "${warning}", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "${warning}", modifiers: "Bold")),
                ], align: Right))),
                (size: "1", pane: Pane(Property(content: [
                    (kind: Property(Widget(States(active_style: (fg: "${secondary}", modifiers: "Bold"), separator_style: (fg: "${fg_muted}")))), style: (fg: "${fg_muted}")),
                    (kind: Text(" ")),
                ], align: Right))),
            ],
        ),
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "${accent}", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "${accent}", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "${accent}", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "${primary}"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "${primary}"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed))), 
                (kind: Text(" / ")), 
                (kind: Property(Status(Duration))), 
                (kind: Group([
                    (kind: Text(" (")), 
                    (kind: Property(Status(Bitrate))), 
                    (kind: Text(" kbps)")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "${accent}", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "${accent}", modifiers: "Bold"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Album)), default: (kind: Text("Unknown Album"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "${primary}"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "${primary}", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "${accent}", modifiers: "Bold"),
                            off_style: (fg: "${primary}", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "${accent}", modifiers: "Bold"),
                            off_style: (fg: "${primary}", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "${accent}", modifiers: "Bold"),
                            off_style: (fg: "${primary}", modifiers: "Dim"),
                            oneshot_style: (fg: "${error}", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "${accent}", modifiers: "Bold"),
                            off_style: (fg: "${primary}", modifiers: "Dim"),
                            oneshot_style: (fg: "${error}", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "${primary}", modifiers: "Bold")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "${on_primary}", bg: "${primary}"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "${on_primary}", bg: "${success}"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
