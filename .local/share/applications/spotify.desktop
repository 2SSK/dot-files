[Desktop Entry]
# Spotify without ads: spotify-adblock (AUR) is preloaded, blocking the ad servers; nothing in
# Spotify itself is patched, so its updates don't break it. Without the library it starts plainly.
Type=Application
Name=Spotify
GenericName=Music Player
Icon=spotify-client
TryExec=spotify
Exec=env LD_PRELOAD=/usr/lib/spotify-adblock.so spotify --uri=%u
Terminal=false
MimeType=x-scheme-handler/spotify;
Categories=Audio;Music;Player;AudioVideo;
StartupWMClass=spotify
