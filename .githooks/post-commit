#!/bin/sh
# Keep ~ in step with the checkout: after each commit on main, links to files that were deleted go
# and stow links new ones. Enabled with: git config core.hooksPath .githooks
[ "$(git symbolic-ref --short -q HEAD)" = main ] || exit 0
live="$(git rev-parse --show-toplevel)"

# links into the checkout whose file is gone (stow keeps them), where stow puts links
{
	find "$HOME" -maxdepth 1 -type l -print
	find "$HOME/.config" "$HOME/.local" -xdev -path "$live" -prune -o -type l -print
} 2>/dev/null |
	while IFS= read -r link; do
		case $(readlink -m "$link") in "$live"/*) [ -e "$link" ] || rm -f "$link" ;; esac
	done
(cd "$live" && stow .) || echo "post-commit: stow failed in $live" >&2
