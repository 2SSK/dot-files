  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#737aa2",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "string",
          "string.quoted",
          "string.template"
        ],
        "settings": {
          "foreground": "#9ece6a"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language",
          "constant.character",
          "constant.other"
        ],
        "settings": {
          "foreground": "#ff9e64"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "storage.modifier",
          "keyword.control"
        ],
        "settings": {
          "foreground": "#bb9af7"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function",
          "meta.function-call",
          "variable.function"
        ],
        "settings": {
          "foreground": "#7aa2f7"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "entity.name.class",
          "support.type",
          "support.class",
          "storage.type",
          "entity.other.inherited-class"
        ],
        "settings": {
          "foreground": "#e0af68"
        }
      },
      {
        "scope": [
          "variable.parameter",
          "variable.language",
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "#7dcfff"
        }
      },
      {
        "scope": [
          "entity.name.tag",
          "invalid"
        ],
        "settings": {
          "foreground": "#f7768e"
        }
      },
      {
        "scope": [
          "punctuation",
          "keyword.operator",
          "meta.brace"
        ],
        "settings": {
          "foreground": "#737aa2"
        }
      },
      {
        "scope": [
          "variable",
          "meta.definition.variable"
        ],
        "settings": {
          "foreground": "#c0caf5"
        }
      },
      {
        "scope": [
          "markup.heading",
          "entity.name.section"
        ],
        "settings": {
          "foreground": "#7aa2f7",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.bold"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.italic"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "markup.inline.raw",
          "markup.fenced_code"
        ],
        "settings": {
          "foreground": "#ff9e64"
        }
      },
      {
        "scope": [
          "markup.underline.link"
        ],
        "settings": {
          "foreground": "#7dcfff"
        }
      },
      {
        "scope": [
          "markup.inserted"
        ],
        "settings": {
          "foreground": "#9ece6a"
        }
      },
      {
        "scope": [
          "markup.deleted"
        ],
        "settings": {
          "foreground": "#f7768e"
        }
      },
      {
        "scope": [
          "markup.changed"
        ],
        "settings": {
          "foreground": "#e0af68"
        }
      }
    ]
  }
}
