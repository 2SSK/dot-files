# With wallpaper.rotate "boot": the next boot's wallpaper is picked as the system shuts down, so the
# login screen and the desktop already show it (desktop-wallpaper next-boot does nothing on a logout).
[Unit]
Description=Pick the next boot's wallpaper while shutting down

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=%h/.local/bin/desktop-wallpaper next-boot
TimeoutStopSec=20

[Install]
WantedBy=default.target
