/*
 * File search (filesearch.sh): the Tokyonight theme reshaped for paths —
 * one wide column, more rows, no icons, and a hint line under the input.
 */

configuration {
    show-icons: false;
}

@import "../theme/tokyonight.rasi"

* {
    fg: #c0caf5;
    text-color: @kl;
    /* The family exactly as installed (no space in "JetBrainsMono"), so the
     * Nerd Font glyphs come from this font and not from a fallback. */
    font: "JetBrainsMono Nerd Font Bold 12";
}

window {
    width: 1000;
}

prompt {
    font: "JetBrainsMono Nerd Font Bold 14";
    margin: 0px 4px 0px 2px;
}

message {
    padding: 6px 11px;
    border: 0px 3px 2px 3px;
}

textbox {
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 10";
}

listview {
    lines: 12;
    columns: 1;
}

element {
    padding: 4px 6px;
}

element-text {
    font: "JetBrainsMono Nerd Font 11";
}

element selected.normal {
    text-color: @black;
}
