// fastfetch: the Saturn logo and only the essentials. ANSI colours follow the theme.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/saturn.txt",
    "color": { "1": "blue" },
    "padding": { "top": 0, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta", "output": "default" },
    "key": { "width": 4 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "separator", "string": "─", "outputColor": "90" },
    { "type": "os", "key": "", "format": "{pretty-name}" },
    { "type": "kernel", "key": "", "format": "{release}" },
    { "type": "wm", "key": "", "format": "{pretty-name}" },
    { "type": "shell", "key": "", "format": "{pretty-name}" },
    { "type": "terminal", "key": "", "format": "{pretty-name}" },
    { "type": "packages", "key": "󰏗" },
    { "type": "memory", "key": "󰍛", "format": "{used} / {total}" },
    { "type": "uptime", "key": "󰔟" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
