{
    "audio": {
        "step": 5
    },
    "bar": {
        "capsules": false,
        "center": [
            "clock"
        ],
        "left": [
            "workspaces",
            "scratchpad",
            "stats"
        ],
        "length": 0,
        "opacity": 0.85,
        "position": "top",
        "right": [
            "recorder",
            "battery",
            "notifications",
            "power"
        ],
        "size": 40,
        "style": "island"
    },
    "brightness": {
        "step": 5
    },
    "notifications": {
        "timeout": 5000
    },
    "osd": {
        "timeout": 1800
    },
    "power": {
        "confirm": true
    },
    "wallpaper": {
        "folders": [
            "~/.local/share/desktop/wallpapers",
            "~/Wallpaper-Bank"
        ],
        "rotate": "off"
    }
}
