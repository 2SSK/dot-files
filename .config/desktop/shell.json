{
    "audio": {
        "recordMic": false,
        "step": 5
    },
    "bar": {
        "capsules": false,
        "center": [
            "clock"
        ],
        "left": [
            "workspaces",
            "scratchpad",
            "stats"
        ],
        "opacity": 0.85,
        "position": "top",
        "right": [
            "battery",
            "notifications"
        ],
        "size": 40,
        "style": "island"
    },
    "brightness": {
        "step": 5
    },
    "calendar": {
        "lead": 10,
        "nextUp": 15
    },
    "clipboard": {
        "days": 30,
        "images": 30,
        "max": 200,
        "persist": true
    },
    "fonts": {
        "barWeight": 600,
        "collection": "inter",
        "scale": 1.15,
        "weight": 600
    },
    "idle": {
        "dim": 4,
        "lock": 5,
        "off": 10
    },
    "nightLight": {
        "from": "19:00",
        "schedule": true,
        "temperature": 4000,
        "to": "07:00"
    },
    "notifications": {
        "timeout": 5000
    },
    "osd": {
        "timeout": 3000
    },
    "power": {
        "batteryLow": 25,
        "confirm": true
    },
    "wallpaper": {
        "folders": [
            "~/.local/share/desktop/wallpapers",
            "~/Wallpaper-Bank"
        ],
        "rotate": "boot"
    }
}
