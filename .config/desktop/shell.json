{
    "audio": {
        "step": 5
    },
    "bar": {
        "capsules": false,
        "center": [
            "clock"
        ],
        "left": [
            "workspaces",
            "scratchpad",
            "stats"
        ],
        "length": 0,
        "opacity": 0.85,
        "position": "top",
        "right": [
            "recorder",
            "battery",
            "notifications",
            "power"
        ],
        "size": 40,
        "style": "island"
    },
    "brightness": {
        "step": 5
    },
    "idle": {
        "dim": 4,
        "lock": 5,
        "off": 10
    },
    "nightLight": {
        "from": "19:00",
        "schedule": true,
        "temperature": 4000,
        "to": "07:00"
    },
    "notifications": {
        "timeout": 5000
    },
    "osd": {
        "timeout": 1800
    },
    "power": {
        "batteryLow": 25,
        "confirm": true
    },
    "wallpaper": {
        "folders": [
            "~/.local/share/desktop/wallpapers",
            "~/Wallpaper-Bank"
        ],
        "rotate": "boot"
    }
}
