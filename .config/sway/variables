# What i3's files (included after this) don't set: the variables they use and the cursor. Font,
# gaps, borders and title alignment come from i3's look.conf; SwayFX's effects from effects.conf.
set $mod Mod4
set $term kitty

set $cursor_theme Bibata-Modern-Ice
seat * xcursor_theme $cursor_theme 24

titlebar_padding 12 6

for_window [app_id=".*"] opacity 1
