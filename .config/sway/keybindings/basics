bindsym $mod+Return exec $term
bindsym $mod+t exec alacritty
bindsym $mod+q kill
bindsym $mod+d exec $menu
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Do you really want to exit sway?' -B 'Yes, exit sway' 'swaymsg exit'
floating_modifier $mod normal

bindsym $mod+shift+p exec --no-startup-id noctalia msg panel-toggle wallpaper
bindsym $mod+comma exec --no-startup-id noctalia msg panel-toggle launcher
bindsym $mod+shift+b exec --no-startup-id noctalia msg bar-toggle
bindsym $mod+p exec --no-startup-id noctalia msg panel-toggle session

bindsym $mod+slash workspace next
bindsym $mod+period workspace prev

bindsym F1 exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym F2 exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym F3 exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym F4 exec brightnessctl set 5%-
bindsym F5 exec brightnessctl set +5%
bindsym F9 exec amixer set Capture toggle

# Screenshots: F12 whole screen (picks the output if there are several), ctrl region, Shift window
bindsym F12 exec noctalia msg screenshot-fullscreen pick
bindsym ctrl+F12 exec noctalia msg screenshot-region
bindsym Shift+F12 exec grimshot save active ~/Pictures/Screenshots/screenshot_$(date +%Y-%m-%d_%H-%M-%S).png

# Apps that grab the keyboard (virt-manager): Super+Escape gives the keys back to sway, and again to the app
bindsym --inhibited $mod+Escape seat - shortcuts_inhibitor toggle
