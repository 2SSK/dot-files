-- psql: results through pspg (PSQL_PAGER, themed from the desktop palette), quiet startup
\set QUIET 1

\pset pager on
\pset border 2
\pset linestyle unicode
\pset null '⟨NULL⟩'
\x auto
\timing on

-- user (blue) @ database (magenta), then psql's state markers
\set PROMPT1 '%[%033[1;34m%]%n%[%033[0m%]@%[%033[1;35m%]%/%[%033[0m%]%R%x%# '
\set PROMPT2 '%[%033[2m%]%R%x%#%[%033[0m%] '

\set HISTFILE ~/.psql_history
\set HISTSIZE 10000
\set HISTCONTROL ignoredups
\set COMP_KEYWORD_CASE upper
\set VERBOSITY verbose

\unset QUIET
