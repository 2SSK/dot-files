-- ==========================================================
-- .psqlrc - psql Power User Configuration
-- ==========================================================

-- Timing on every query (invaluable for performance work)
\timing on

-- Pretty format with borders
\x auto

-- Better NULL display (no empty spaces)
\pset null '⟨NULL⟩'

-- Prompt: user (blue) @ database (magenta), then psql's state markers; ANSI colours follow the theme
\set PROMPT1 '%[%033[1;34m%]%n%[%033[0m%]@%[%033[1;35m%]%/%[%033[0m%]%R%x%# '
\set PROMPT2 '%[%033[2m%]%R%x%#%[%033[0m%] '

-- History settings
\set HISTSIZE 10000
\set HISTFILE ~/.psql_history

-- Auto-commit on (safer for learning)
\set AUTOCOMMIT on

-- Verbose errors
\set VERBOSITY verbose

-- Default to expanded mode for wide tables
\pset expanded auto

-- Results through pspg (PSQL_PAGER) with unicode borders
\pset pager on
\pset border 2
\pset linestyle unicode

-- Encoding
\encoding UTF8
