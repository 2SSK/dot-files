# Not stowed into $HOME (stow regexes; a leading / anchors at the repo root)
\.git
\.gitignore
\.gitmodules
\.stowrc
__pycache__
^/[^/]*\.md
^/LICENSE
^/packages
^/system
^/tests
^/docs
^/setup\.sh
^/\.github
^/\.claude/settings\.local\.json
# opencode's own files in its folder, never linked: its plugins' node_modules and lock files, and
# the local .env of keys (the live one stays the real file)
^/\.config/opencode/(\.env|\.gitignore|bun\.lock|package\.json|node_modules)
# Not stowed yet: the live ~/.claude stays as it is
^/\.claude
^/\.githooks
